# ─── Database ──────────────────────────────────────
# Vercel Postgres / Neon / Supabase connection string (pooled)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Direct connection (non-pooled) — used for migrations only
# For Neon: use the non-pooled hostname (without -pooler)
# For Supabase: use the "Direct connection" string
# For local dev: same as DATABASE_URL
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── Auth ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"

# ─── AI (optional) ────────────────────────────────
# Required for AI-powered file import analysis
# Without this, file imports fall back to heuristic column matching
ANTHROPIC_API_KEY=""

# ─── App URL ───────────────────────────────────────
# Set automatically by Vercel; only needed for local dev
NEXTAUTH_URL="http://localhost:3000"
