generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// AUTH MODELS (required by @auth/prisma-adapter)
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(STAFF)

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  PASTOR
  STAFF
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ──────────────────────────────────────────────
// DOMAIN MODELS
// ──────────────────────────────────────────────

model Person {
  id          String       @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  status      PersonStatus @default(VISITOR)
  dateOfBirth DateTime?
  gender      Gender?
  notes       String?

  warmthScore     Int         @default(50)
  warmthLabel     WarmthLevel @default(LUKEWARM)
  warmthUpdatedAt DateTime?

  householdId   String?
  householdRole HouseholdRole @default(MEMBER)
  household     Household?    @relation(fields: [householdId], references: [id])

  groupMemberships GroupMember[]
  attendances      Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([status])
  @@index([warmthScore])
  @@index([householdId])
}

enum PersonStatus {
  VISITOR
  REGULAR
  MEMBER
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum WarmthLevel {
  HOT
  WARM
  LUKEWARM
  COOL
  COLD
}

model Household {
  id      String @id @default(cuid())
  name    String
  address String?

  members Person[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HouseholdRole {
  HEAD
  SPOUSE
  CHILD
  MEMBER
  OTHER
}

model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        GroupType
  meetingDay  String?
  meetingTime String?
  isActive    Boolean   @default(true)

  members GroupMember[]
  events  Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

enum GroupType {
  LIFE_GROUP
  MINISTRY
  CLASS
  COMMITTEE
  OTHER
}

model GroupMember {
  id       String         @id @default(cuid())
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  groupId String
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([personId, groupId])
  @@index([groupId])
  @@index([personId])
}

enum GroupMemberRole {
  LEADER
  CO_LEADER
  MEMBER
}

model Event {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        EventType
  date        DateTime
  endDate     DateTime?

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@index([groupId])
}

enum EventType {
  SUNDAY_SERVICE
  SMALL_GROUP
  SPECIAL_EVENT
  CLASS
  OTHER
}

model Attendance {
  id     String           @id @default(cuid())
  status AttendanceStatus @default(PRESENT)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  eventId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([personId, eventId])
  @@index([personId])
  @@index([eventId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}
