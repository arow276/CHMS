generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────
// AUTH MODELS (required by @auth/prisma-adapter)
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(STAFF)

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  PASTOR
  STAFF
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ──────────────────────────────────────────────
// DOMAIN MODELS
// ──────────────────────────────────────────────

model Person {
  id          String       @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  status      PersonStatus @default(VISITOR)
  dateOfBirth DateTime?
  gender      Gender?
  notes       String?

  warmthScore     Int         @default(50)
  warmthLabel     WarmthLevel @default(LUKEWARM)
  warmthUpdatedAt DateTime?

  householdId   String?
  householdRole HouseholdRole @default(MEMBER)
  household     Household?    @relation(fields: [householdId], references: [id])

  groupMemberships GroupMember[]
  attendances      Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([status])
  @@index([warmthScore])
  @@index([householdId])
}

enum PersonStatus {
  VISITOR
  REGULAR
  MEMBER
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum WarmthLevel {
  HOT
  WARM
  LUKEWARM
  COOL
  COLD
}

model Household {
  id      String @id @default(cuid())
  name    String
  address String?

  members Person[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HouseholdRole {
  HEAD
  SPOUSE
  CHILD
  MEMBER
  OTHER
}

model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        GroupType
  meetingDay  String?
  meetingTime String?
  isActive    Boolean   @default(true)

  members GroupMember[]
  events  Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

enum GroupType {
  LIFE_GROUP
  MINISTRY
  CLASS
  COMMITTEE
  OTHER
}

model GroupMember {
  id       String         @id @default(cuid())
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  groupId String
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([personId, groupId])
  @@index([groupId])
  @@index([personId])
}

enum GroupMemberRole {
  LEADER
  CO_LEADER
  MEMBER
}

model Event {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        EventType
  date        DateTime
  endDate     DateTime?

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@index([groupId])
}

enum EventType {
  SUNDAY_SERVICE
  SMALL_GROUP
  SPECIAL_EVENT
  CLASS
  OTHER
}

model Attendance {
  id     String           @id @default(cuid())
  status AttendanceStatus @default(PRESENT)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  eventId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([personId, eventId])
  @@index([personId])
  @@index([eventId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// ──────────────────────────────────────────────
// CHURCH BRAND (one row per tenant)
// Drives the auto-generated public website + app
// ──────────────────────────────────────────────

model Church {
  id           String  @id @default(cuid())
  name         String  @default("Our Church")
  slug         String  @unique @default("our-church")
  tagline      String?
  mission      String?
  about        String?
  logoUrl      String?
  primaryColor String  @default("#0EA5E9")
  accentColor  String  @default("#F59E0B")
  bgColor      String  @default("#FFFFFF")
  textColor    String  @default("#0F172A")
  fontFamily   String  @default("Inter")
  address      String?
  city         String?
  state        String?
  zip          String?
  phone        String?
  email        String?
  websiteUrl   String?
  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  serviceTimes String?
  publishSite  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────
// UNIFIED GATHERING
// One model = events + calendar + registration + volunteers
// ──────────────────────────────────────────────

model Gathering {
  id          String            @id @default(cuid())
  name        String
  summary     String?
  description String?
  category    GatheringCategory @default(EVENT)
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean           @default(false)
  recurrence  String?
  location    String?
  imageUrl    String?

  isPublic    Boolean @default(true)
  isPublished Boolean @default(true)

  registrationOpen   Boolean   @default(false)
  registrationCloses DateTime?
  capacity           Int?
  costCents          Int       @default(0)
  customQuestions    Json?

  registrations  Registration[]
  volunteerRoles VolunteerRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([category])
  @@index([isPublic])
}

enum GatheringCategory {
  WORSHIP_SERVICE
  EVENT
  CLASS
  SMALL_GROUP
  MEETING
  OUTREACH
  KIDS
  YOUTH
  OTHER
}

model Registration {
  id        String             @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  partySize Int                @default(1)
  notes     String?
  answers   Json?
  paid      Boolean            @default(false)
  status    RegistrationStatus @default(CONFIRMED)

  gatheringId String
  gathering   Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gatheringId])
  @@index([email])
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELED
}

model VolunteerRole {
  id          String  @id @default(cuid())
  name        String
  description String?
  slotsNeeded Int     @default(1)

  gatheringId String
  gathering   Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)

  signups VolunteerSignup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gatheringId])
}

model VolunteerSignup {
  id        String  @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  confirmed Boolean @default(true)

  roleId String
  role   VolunteerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
}

// ──────────────────────────────────────────────
// ASSISTANT MEMORY
// Log of prompts the admin has run, used to show history & undo
// ──────────────────────────────────────────────

model AssistantAction {
  id        String   @id @default(cuid())
  prompt    String
  intent    String
  summary   String
  status    String   @default("done")
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ──────────────────────────────────────────────
// IMPORT & INTEGRATION MODELS
// ──────────────────────────────────────────────

model CategoryDefinition {
  id        String  @id @default(cuid())
  category  String  // "person_status", "group_type", "event_type", "household_role", "group_member_role"
  value     String  // Internal value stored in records
  label     String  // Church's display label
  description String?
  color     String? // Optional hex color for UI
  icon      String? // Optional icon name
  isDefault Boolean @default(false)
  isSystem  Boolean @default(false) // System categories can't be deleted
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@index([category])
}

model ChmsConnector {
  id          String  @id @default(cuid())
  platform    String  // "planning_center", "breeze", "ccb", "elvanto", "rock_rms", "fellowship_one", "ministry_platform"
  displayName String
  credentials Json    // OAuth tokens, API keys (encrypted at rest via app layer)
  status      String  @default("disconnected") // "connected", "disconnected", "syncing", "error"
  lastSyncAt  DateTime?
  lastError   String?
  config      Json    @default("{}")
  syncSchedule String? // "manual", "daily", "weekly"

  importJobs ImportJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform])
}

model ImportJob {
  id             String  @id @default(cuid())
  source         String  // "file_upload", "planning_center", "breeze", etc.
  fileName       String?
  status         String  @default("pending") // "pending", "analyzing", "mapped", "reviewing", "importing", "complete", "error"
  totalRows      Int     @default(0)
  importedRows   Int     @default(0)
  skippedRows    Int     @default(0)
  errorRows      Int     @default(0)
  columnMapping  Json?   // { sourceColumn: { targetField, transform? } }
  categoryMapping Json?  // { sourceCategory: { sourceValue: mappedValue } }
  aiAnalysis     Json?   // Full AI analysis: detected types, recommendations, confidence
  errors         Json?   // Array of { row, field, message }
  importedData   Json?   // Summary of what was imported

  connectorId String?
  connector   ChmsConnector? @relation(fields: [connectorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
}
